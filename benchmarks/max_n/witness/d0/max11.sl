(constraint (>= (max11 x1 x2 x3 x4 x5 x6 x7 x8 x9 x10 x11) x7))
(constraint (>= (max11 x1 x2 x3 x4 x5 x6 x7 x8 x9 x10 x11) x8))
(constraint (>= (max11 x1 x2 x3 x4 x5 x6 x7 x8 x9 x10 x11) x9))
(constraint (>= (max11 x1 x2 x3 x4 x5 x6 x7 x8 x9 x10 x11) x10))
(constraint (>= (max11 x1 x2 x3 x4 x5 x6 x7 x8 x9 x10 x11) x11))
(constraint (=> (and (>= x1 x2) (>= x1 x3) (>= x1 x4) (>= x1 x5) (>= x1 x6) (>= x1 x7) (>= x1 x8) (>= x1 x9) (>= x1 x10) (>= x1 x11)) (= (max11 x1 x2 x3 x4 x5 x6 x7 x8 x9 x10 x11) x1)))
(constraint (=> (and (>= x2 x1) (>= x2 x3) (>= x2 x4) (>= x2 x5) (>= x2 x6) (>= x2 x7) (>= x2 x8) (>= x2 x9) (>= x2 x10) (>= x2 x11)) (= (max11 x1 x2 x3 x4 x5 x6 x7 x8 x9 x10 x11) x2)))
(constraint (=> (and (>= x3 x1) (>= x3 x2) (>= x3 x4) (>= x3 x5) (>= x3 x6) (>= x3 x7) (>= x3 x8) (>= x3 x9) (>= x3 x10) (>= x3 x11)) (= (max11 x1 x2 x3 x4 x5 x6 x7 x8 x9 x10 x11) x3)))
(constraint (=> (and (>= x4 x1) (>= x4 x2) (>= x4 x3) (>= x4 x5) (>= x4 x6) (>= x4 x7) (>= x4 x8) (>= x4 x9) (>= x4 x10) (>= x4 x11)) (= (max11 x1 x2 x3 x4 x5 x6 x7 x8 x9 x10 x11) x4)))
(constraint (=> (and (>= x5 x1) (>= x5 x2) (>= x5 x3) (>= x5 x4) (>= x5 x6) (>= x5 x7) (>= x5 x8) (>= x5 x9) (>= x5 x10) (>= x5 x11)) (= (max11 x1 x2 x3 x4 x5 x6 x7 x8 x9 x10 x11) x5)))
(constraint (=> (and (>= x6 x1) (>= x6 x2) (>= x6 x3) (>= x6 x4) (>= x6 x5) (>= x6 x7) (>= x6 x8) (>= x6 x9) (>= x6 x10) (>= x6 x11)) (= (max11 x1 x2 x3 x4 x5 x6 x7 x8 x9 x10 x11) x6)))
(constraint (=> (and (>= x7 x1) (>= x7 x2) (>= x7 x3) (>= x7 x4) (>= x7 x5) (>= x7 x6) (>= x7 x8) (>= x7 x9) (>= x7 x10) (>= x7 x11)) (= (max11 x1 x2 x3 x4 x5 x6 x7 x8 x9 x10 x11) x7)))
(constraint (=> (and (>= x8 x1) (>= x8 x2) (>= x8 x3) (>= x8 x4) (>= x8 x5) (>= x8 x6) (>= x8 x7) (>= x8 x9) (>= x8 x10) (>= x8 x11)) (= (max11 x1 x2 x3 x4 x5 x6 x7 x8 x9 x10 x11) x8)))
(constraint (=> (and (>= x9 x1) (>= x9 x2) (>= x9 x3) (>= x9 x4) (>= x9 x5) (>= x9 x6) (>= x9 x7) (>= x9 x8) (>= x9 x10) (>= x9 x11)) (= (max11 x1 x2 x3 x4 x5 x6 x7 x8 x9 x10 x11) x9)))
(constraint (=> (and (>= x10 x1) (>= x10 x2) (>= x10 x3) (>= x10 x4) (>= x10 x5) (>= x10 x6) (>= x10 x7) (>= x10 x8) (>= x10 x9) (>= x10 x11)) (= (max11 x1 x2 x3 x4 x5 x6 x7 x8 x9 x10 x11) x10)))
(constraint (=> (and (>= x11 x1) (>= x11 x2) (>= x11 x3) (>= x11 x4) (>= x11 x5) (>= x11 x6) (>= x11 x7) (>= x11 x8) (>= x11 x9) (>= x11 x10)) (= (max11 x1 x2 x3 x4 x5 x6 x7 x8 x9 x10 x11) x11)))

(check-synth)
