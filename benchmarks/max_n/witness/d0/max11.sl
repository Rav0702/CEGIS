(set-logic LIA)

(synth-fun max11 ((x1 Int) (x2 Int) (x3 Int) (x4 Int) (x5 Int) (x6 Int) (x7 Int) (x8 Int) (x9 Int) (x10 Int) (x11 Int)) Int
  ((Start Int) (CondExpr Bool))
  ((Start Int (x1 x2 x3 x4 x5 x6 x7 x8 x9 x10 x11 (ite CondExpr Start Start)))
   (CondExpr Bool ((< Start Start) (<= Start Start) (> Start Start) (>= Start Start))))
)

(declare-var x1 Int)
(declare-var x2 Int)
(declare-var x3 Int)
(declare-var x4 Int)
(declare-var x5 Int)
(declare-var x6 Int)
(declare-var x7 Int)
(declare-var x8 Int)
(declare-var x9 Int)
(declare-var x10 Int)
(declare-var x11 Int)

(constraint (>= (max11 x1 x2 x3 x4 x5 x6 x7 x8 x9 x10 x11) x1))
(constraint (>= (max11 x1 x2 x3 x4 x5 x6 x7 x8 x9 x10 x11) x2))
(constraint (>= (max11 x1 x2 x3 x4 x5 x6 x7 x8 x9 x10 x11) x3))
