(set-logic LIA)

(synth-fun max8 ((x1 Int) (x2 Int) (x3 Int) (x4 Int) (x5 Int) (x6 Int) (x7 Int) (x8 Int)) Int
  ((Start Int) (CondExpr Bool))
  ((Start Int (x1 x2 x3 x4 x5 x6 x7 x8 (ite CondExpr Start Start)))
   (CondExpr Bool ((< Start Start) (<= Start Start) (> Start Start) (>= Start Start))))
)

(declare-var x1 Int)
(declare-var x2 Int)
(declare-var x3 Int)
(declare-var x4 Int)
(declare-var x5 Int)
(declare-var x6 Int)
(declare-var x7 Int)
(declare-var x8 Int)

(constraint (>= (max8 x1 x2 x3 x4 x5 x6 x7 x8) x1))
(constraint (>= (max8 x1 x2 x3 x4 x5 x6 x7 x8) x2))
(constraint (>= (max8 x1 x2 x3 x4 x5 x6 x7 x8) x3))
(constraint (>= (max8 x1 x2 x3 x4 x5 x6 x7 x8) x4))
(constraint (>= (max8 x1 x2 x3 x4 x5 x6 x7 x8) x5))
(constraint (>= (max8 x1 x2 x3 x4 x5 x6 x7 x8) x6))
(constraint (>= (max8 x1 x2 x3 x4 x5 x6 x7 x8) x7))
(constraint (>= (max8 x1 x2 x3 x4 x5 x6 x7 x8) x8))
(constraint (=> (and (>= x1 x2) (>= x1 x3) (>= x1 x4) (>= x1 x5) (>= x1 x6) (>= x1 x7) (>= x1 x8)) (= (max8 x1 x2 x3 x4 x5 x6 x7 x8) x1)))
(constraint (=> (and (>= x2 x1) (>= x2 x3) (>= x2 x4) (>= x2 x5) (>= x2 x6) (>= x2 x7) (>= x2 x8)) (= (max8 x1 x2 x3 x4 x5 x6 x7 x8) x2)))
(constraint (=> (and (>= x3 x1) (>= x3 x2) (>= x3 x4) (>= x3 x5) (>= x3 x6) (>= x3 x7) (>= x3 x8)) (= (max8 x1 x2 x3 x4 x5 x6 x7 x8) x3)))
(constraint (=> (and (>= x4 x1) (>= x4 x2) (>= x4 x3) (>= x4 x5) (>= x4 x6) (>= x4 x7) (>= x4 x8)) (= (max8 x1 x2 x3 x4 x5 x6 x7 x8) x4)))
(constraint (=> (and (>= x5 x1) (>= x5 x2) (>= x5 x3) (>= x5 x4) (>= x5 x6) (>= x5 x7) (>= x5 x8)) (= (max8 x1 x2 x3 x4 x5 x6 x7 x8) x5)))
(constraint (=> (and (>= x6 x1) (>= x6 x2) (>= x6 x3) (>= x6 x4) (>= x6 x5) (>= x6 x7) (>= x6 x8)) (= (max8 x1 x2 x3 x4 x5 x6 x7 x8) x6)))
(constraint (=> (and (>= x7 x1) (>= x7 x2) (>= x7 x3) (>= x7 x4) (>= x7 x5) (>= x7 x6) (>= x7 x8)) (= (max8 x1 x2 x3 x4 x5 x6 x7 x8) x7)))
(constraint (=> (and (>= x8 x1) (>= x8 x2) (>= x8 x3) (>= x8 x4) (>= x8 x5) (>= x8 x6) (>= x8 x7)) (= (max8 x1 x2 x3 x4 x5 x6 x7 x8) x8)))

(check-synth)
