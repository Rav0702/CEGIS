; isseries3 — are ours/ and cdgp/ the same specification?
; GENERATED by build_pairs.py. Two checks, both must answer unsat:
;   1. ours entails theirs      2. theirs entails ours
; Pointwise is sound: every constraint mentions the synth-fun at one
; and the same argument tuple.

(set-logic LIA)
(declare-const x Int)
(declare-const y Int)
(declare-const z Int)
(declare-fun isseries3 (Int Int Int) Bool)

(push 1)  ; 1. ours /\ not theirs
(assert (= (isseries3 x y z) (= (- y x) (- z y))))
(assert (not (and (=> (= (- y x) (- z y)) (= (isseries3 x y z) true)) (=> (not (= (- y x) (- z y))) (= (isseries3 x y z) false)))))
(check-sat)
(pop 1)

(push 1)  ; 2. theirs /\ not ours
(assert (=> (= (- y x) (- z y)) (= (isseries3 x y z) true)))
(assert (=> (not (= (- y x) (- z y))) (= (isseries3 x y z) false)))
(assert (not (= (isseries3 x y z) (= (- y x) (- z y)))))
(check-sat)
(pop 1)
