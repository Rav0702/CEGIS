; issorted4 — are ours/ and cdgp/ the same specification?
; GENERATED by build_pairs.py. Two checks, both must answer unsat:
;   1. ours entails theirs      2. theirs entails ours
; Pointwise is sound: every constraint mentions the synth-fun at one
; and the same argument tuple.

(set-logic LIA)
(declare-const x Int)
(declare-const y Int)
(declare-const z Int)
(declare-const w Int)
(declare-fun issorted4 (Int Int Int Int) Bool)

(push 1)  ; 1. ours /\ not theirs
(assert (= (issorted4 x y z w) (and (<= x y) (and (<= y z) (<= z w)))))
(assert (not (and (=> (and (<= x y) (and (<= y z) (<= z w))) (= (issorted4 x y z w) true)) (=> (not (and (<= x y) (and (<= y z) (<= z w)))) (= (issorted4 x y z w) false)))))
(check-sat)
(pop 1)

(push 1)  ; 2. theirs /\ not ours
(assert (=> (and (<= x y) (and (<= y z) (<= z w))) (= (issorted4 x y z w) true)))
(assert (=> (not (and (<= x y) (and (<= y z) (<= z w)))) (= (issorted4 x y z w) false)))
(assert (not (= (issorted4 x y z w) (and (<= x y) (and (<= y z) (<= z w))))))
(check-sat)
(pop 1)
