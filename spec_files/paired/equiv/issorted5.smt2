; issorted5 — are ours/ and cdgp/ the same specification?
; GENERATED by build_pairs.py. Two checks, both must answer unsat:
;   1. ours entails theirs      2. theirs entails ours
; Pointwise is sound: every constraint mentions the synth-fun at one
; and the same argument tuple.

(set-logic LIA)
(declare-const x Int)
(declare-const y Int)
(declare-const z Int)
(declare-const w Int)
(declare-const v Int)
(declare-fun issorted5 (Int Int Int Int Int) Bool)

(push 1)  ; 1. ours /\ not theirs
(assert (= (issorted5 x y z w v) (and (<= x y) (and (<= y z) (and (<= z w) (<= w v))))))
(assert (not (and (=> (and (<= x y) (<= y z) (<= z w) (<= w v)) (= (issorted5 x y z w v) true)) (=> (not (and (<= x y) (<= y z) (<= z w) (<= w v))) (= (issorted5 x y z w v) false)))))
(check-sat)
(pop 1)

(push 1)  ; 2. theirs /\ not ours
(assert (=> (and (<= x y) (<= y z) (<= z w) (<= w v)) (= (issorted5 x y z w v) true)))
(assert (=> (not (and (<= x y) (<= y z) (<= z w) (<= w v))) (= (issorted5 x y z w v) false)))
(assert (not (= (issorted5 x y z w v) (and (<= x y) (and (<= y z) (and (<= z w) (<= w v)))))))
(check-sat)
(pop 1)
