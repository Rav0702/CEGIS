(set-logic LIA)

(synth-fun countpos4 ( (x Int) (y Int) (z Int) (w Int) ) Int
    ((Start Int (x y z w 0 1
                 (+ Start Start)
                 (- Start Start)
                 (ite StartBool Start Start)))
     (StartBool Bool ((and StartBool StartBool)
                      (or  StartBool StartBool)
                      (not StartBool)
                      (<=  Start Start)
                      (=   Start Start)
                      (>=  Start Start)))))

(declare-var x Int)
(declare-var y Int)
(declare-var z Int)
(declare-var w Int)

(define-fun isPos ((x Int)) Int (ite (> x 0) 1 0))

(constraint (= (countpos4 x y z w) (+ (isPos x) (isPos y) (isPos z) (isPos w)) ))

(check-synth)
