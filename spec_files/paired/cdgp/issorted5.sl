; issorted5.sl — CDGP's specification of this problem.
;
; GENERATED by spec_files/paired/build_pairs.py — do not edit by hand.
;
; Constraints transcribed from
;   ~/.julia/dev/CDGP/resources/benchmarks_phd/cdgp/LIA/other/SortedAscending5.sl
; with their parameters renamed a,b,c,d,e -> x,y,z,w,v.
;
; The synth-fun signature and grammar block are copied verbatim from
;   spec_files/cdgp_paper/issorted5.sl
; so this file and ours/issorted5.sl differ ONLY in specification style.
;
;   RETURN SORT ADAPTED. CDGP declares this predicate as an Int-valued
;   function returning 1/0; ours declares it Bool. Those are different
;   synthesis problems (different start non-terminal, different SMT sort),
;   so a literal transcription would not be a controlled pair. Their `(=
;   (f ...) 1)` / `(= (f ...) 0)` results are rewritten to `true` /
;   `false`, which preserves their case-split STRUCTURE (the experimental
;   variable) while holding the return sort fixed.

(set-logic LIA)

(synth-fun issorted5 ( (x Int) (y Int) (z Int) (w Int) (v Int) ) Bool
    ((StartBool Bool ((and StartBool StartBool)
                      (or  StartBool StartBool)
                      (not StartBool)
                      (<=  Start Start)
                      (=   Start Start)
                      (>=  Start Start)))
     (Start Int (x y z w v 0 1
                 (+ Start Start)
                 (- Start Start)
                 (ite StartBool Start Start)))))

(declare-var x Int)
(declare-var y Int)
(declare-var z Int)
(declare-var w Int)
(declare-var v Int)

(constraint (=> (and (<= x y) (<= y z) (<= z w) (<= w v)) (= (issorted5 x y z w v) true)))
(constraint (=> (not (and (<= x y) (<= y z) (<= z w) (<= w v))) (= (issorted5 x y z w v) false)))

(check-synth)
