; above8.sl — generated by scripts/gen_scaled_specs.py: any value strictly greater than all of
; 8 integers (multi-answer; as spec_files/multi_answer/above4.sl). Known solution: max + 1.

(set-logic LIA)

(synth-fun above8 ( (x1 Int) (x2 Int) (x3 Int) (x4 Int) (x5 Int) (x6 Int) (x7 Int) (x8 Int) ) Int
    ((Start Int (x1 x2 x3 x4 x5 x6 x7 x8 0 1
                 (+ Start Start)
                 (- Start Start)
                 (ite StartBool Start Start)))
     (StartBool Bool ((and StartBool StartBool)
                      (or  StartBool StartBool)
                      (not StartBool)
                      (<=  Start Start)
                      (=   Start Start)
                      (>=  Start Start)))))

(declare-var x1 Int)
(declare-var x2 Int)
(declare-var x3 Int)
(declare-var x4 Int)
(declare-var x5 Int)
(declare-var x6 Int)
(declare-var x7 Int)
(declare-var x8 Int)

(constraint (> (above8 x1 x2 x3 x4 x5 x6 x7 x8) x1))
(constraint (> (above8 x1 x2 x3 x4 x5 x6 x7 x8) x2))
(constraint (> (above8 x1 x2 x3 x4 x5 x6 x7 x8) x3))
(constraint (> (above8 x1 x2 x3 x4 x5 x6 x7 x8) x4))
(constraint (> (above8 x1 x2 x3 x4 x5 x6 x7 x8) x5))
(constraint (> (above8 x1 x2 x3 x4 x5 x6 x7 x8) x6))
(constraint (> (above8 x1 x2 x3 x4 x5 x6 x7 x8) x7))
(constraint (> (above8 x1 x2 x3 x4 x5 x6 x7 x8) x8))

(check-synth)
