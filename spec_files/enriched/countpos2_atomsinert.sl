; E5 inert placebo for atoms: 4 always-false atoms (d ≥ d + 1 with d = left − right of a real atom) and 1 terms equal to 0 or a variable (each 1 of a real term replaced by 0).

; countpos2.sl — CDGP's specification of this problem.
;
; GENERATED by spec_files/paired/build_pairs.py — do not edit by hand.
;
; Constraints transcribed from
;   ~/.julia/dev/CDGP/resources/benchmarks_phd/cdgp/LIA/other/CountPositive2.sl
; with their parameters renamed a,b -> x,y.
;
; The synth-fun signature and grammar block are copied verbatim from
;   spec_files/cdgp_paper/countpos2.sl
; so this file and ours/countpos2.sl differ ONLY in specification style.

(set-logic LIA)

(synth-fun countpos2 ((x Int) (y Int)) Int
    (
     (Start Int (x
                 y
                 0
                 1
                 (+ Start Start)
                 (- Start Start)
                 (ite StartBool Start Start)
                 (+ 0 0)))
     (StartBool Bool ((and StartBool StartBool)
                      (or StartBool StartBool)
                      (not StartBool)
                      (<= Start Start)
                      (= Start Start)
                      (>= Start Start)
                      (<= (+ (- x 0) 1) (- x 0))
                      (<= (+ (- y 0) 1) (- y 0))
                      (>= (- x 1) (+ (- x 1) 1))
                      (>= (- y 1) (+ (- y 1) 1))))))

(declare-var x Int)
(declare-var y Int)

(constraint (=> (and (<= x 0) (<= y 0)) (= (countpos2 x y) 0)))
(constraint (=> (and (> x 0)  (<= y 0)) (= (countpos2 x y) 1)))
(constraint (=> (and (<= x 0) (> y 0))  (= (countpos2 x y) 1)))
(constraint (=> (and (> x 0)  (> y 0))  (= (countpos2 x y) 2)))

(check-synth)
