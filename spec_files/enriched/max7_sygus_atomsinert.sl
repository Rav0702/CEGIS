; max7_sygus_atomsinert.sl — generated by scripts/gen_enriched_grammars.jl from spec_files/grammar_variants/max7_sygus.sl.
; E5 inert placebo for atoms: 42 always-false atoms (d ≥ d + 1 with d = left − right of a real atom) and 0 terms equal to 0 or a variable (each 1 of a real term replaced by 0).

; max7_sygus.sl — max7_simple.sl's constraints with the SyGuS-COMP LIA grammar block of the
; competition's max_n benchmarks (as copied in spec_files/paired/cdgp/max4.sl): variables, 0, 1,
; + -, ite, and/or/not, <= = >=. The "official" grammar variant of max7 (2026-09-28).

(set-logic LIA)

(synth-fun max7 ((x0 Int) (x1 Int) (x2 Int) (x3 Int) (x4 Int) (x5 Int) (x6 Int)) Int
    (
     (Start Int (x0
                 x1
                 x2
                 x3
                 x4
                 x5
                 x6
                 0
                 1
                 (+ Start Start)
                 (- Start Start)
                 (ite StartBool Start Start)))
     (StartBool Bool ((and StartBool StartBool)
                      (or StartBool StartBool)
                      (not StartBool)
                      (<= Start Start)
                      (= Start Start)
                      (>= Start Start)
                      (>= (- x0 x1) (+ (- x0 x1) 1))
                      (>= (- x0 x2) (+ (- x0 x2) 1))
                      (>= (- x0 x3) (+ (- x0 x3) 1))
                      (>= (- x0 x4) (+ (- x0 x4) 1))
                      (>= (- x0 x5) (+ (- x0 x5) 1))
                      (>= (- x0 x6) (+ (- x0 x6) 1))
                      (>= (- x1 x0) (+ (- x1 x0) 1))
                      (>= (- x1 x2) (+ (- x1 x2) 1))
                      (>= (- x1 x3) (+ (- x1 x3) 1))
                      (>= (- x1 x4) (+ (- x1 x4) 1))
                      (>= (- x1 x5) (+ (- x1 x5) 1))
                      (>= (- x1 x6) (+ (- x1 x6) 1))
                      (>= (- x2 x0) (+ (- x2 x0) 1))
                      (>= (- x2 x1) (+ (- x2 x1) 1))
                      (>= (- x2 x3) (+ (- x2 x3) 1))
                      (>= (- x2 x4) (+ (- x2 x4) 1))
                      (>= (- x2 x5) (+ (- x2 x5) 1))
                      (>= (- x2 x6) (+ (- x2 x6) 1))
                      (>= (- x3 x0) (+ (- x3 x0) 1))
                      (>= (- x3 x1) (+ (- x3 x1) 1))
                      (>= (- x3 x2) (+ (- x3 x2) 1))
                      (>= (- x3 x4) (+ (- x3 x4) 1))
                      (>= (- x3 x5) (+ (- x3 x5) 1))
                      (>= (- x3 x6) (+ (- x3 x6) 1))
                      (>= (- x4 x0) (+ (- x4 x0) 1))
                      (>= (- x4 x1) (+ (- x4 x1) 1))
                      (>= (- x4 x2) (+ (- x4 x2) 1))
                      (>= (- x4 x3) (+ (- x4 x3) 1))
                      (>= (- x4 x5) (+ (- x4 x5) 1))
                      (>= (- x4 x6) (+ (- x4 x6) 1))
                      (>= (- x5 x0) (+ (- x5 x0) 1))
                      (>= (- x5 x1) (+ (- x5 x1) 1))
                      (>= (- x5 x2) (+ (- x5 x2) 1))
                      (>= (- x5 x3) (+ (- x5 x3) 1))
                      (>= (- x5 x4) (+ (- x5 x4) 1))
                      (>= (- x5 x6) (+ (- x5 x6) 1))
                      (>= (- x6 x0) (+ (- x6 x0) 1))
                      (>= (- x6 x1) (+ (- x6 x1) 1))
                      (>= (- x6 x2) (+ (- x6 x2) 1))
                      (>= (- x6 x3) (+ (- x6 x3) 1))
                      (>= (- x6 x4) (+ (- x6 x4) 1))
                      (>= (- x6 x5) (+ (- x6 x5) 1))))))

(declare-var x0 Int)
(declare-var x1 Int)
(declare-var x2 Int)
(declare-var x3 Int)
(declare-var x4 Int)
(declare-var x5 Int)
(declare-var x6 Int)
(constraint (>= (max7 x0 x1 x2 x3 x4 x5 x6) x0))
(constraint (>= (max7 x0 x1 x2 x3 x4 x5 x6) x1))
(constraint (>= (max7 x0 x1 x2 x3 x4 x5 x6) x2))
(constraint (>= (max7 x0 x1 x2 x3 x4 x5 x6) x3))
(constraint (>= (max7 x0 x1 x2 x3 x4 x5 x6) x4))
(constraint (>= (max7 x0 x1 x2 x3 x4 x5 x6) x5))
(constraint (>= (max7 x0 x1 x2 x3 x4 x5 x6) x6))
(constraint (or (= x0 (max7 x0 x1 x2 x3 x4 x5 x6))
            (or (= x1 (max7 x0 x1 x2 x3 x4 x5 x6))
            (or (= x2 (max7 x0 x1 x2 x3 x4 x5 x6))
            (or (= x3 (max7 x0 x1 x2 x3 x4 x5 x6))
            (or (= x4 (max7 x0 x1 x2 x3 x4 x5 x6))
            (or (= x5 (max7 x0 x1 x2 x3 x4 x5 x6))
            (= x6 (max7 x0 x1 x2 x3 x4 x5 x6)))))))))

(check-synth)
