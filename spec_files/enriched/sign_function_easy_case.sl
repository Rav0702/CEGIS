; Spec-enriched grammar: one production (ite G_t t Start) per answer recipe (3).

; sign_function_easy.sl — confirmatory-phase spec (spec_knowledge/FULL_SCALE_PLAN.md).
;
; GENERATED by scripts/make_confirmatory_specs.py — do not edit by hand.
; Constraints verbatim from
;   CEGIS\benchmarks\sign_function\easy.sl
; which has no grammar block. The CDGP-paper LIA grammar is added, the parameters are named like the
; declared variables, and unused declare-funs are dropped.

(set-logic LIA)

(synth-fun sign ((x Int)) Int
    (
     (Start Int (x
                 0
                 1
                 (+ Start Start)
                 (- Start Start)
                 (ite StartBool Start Start)
                 (ite (>= x 1) 1 Start)
                 (ite (= x 0) 0 Start)
                 (ite (<= x (- 0 1)) (- 0 1) Start)))
     (StartBool Bool ((and StartBool StartBool)
                      (or StartBool StartBool)
                      (not StartBool)
                      (<= Start Start)
                      (= Start Start)
                      (>= Start Start)))))
(declare-var x Int)

(constraint (=> (> x 0) (= (sign x) 1)))

(constraint (=> (= x 0) (= (sign x) 0)))

(constraint (=> (< x 0) (= (sign x) (- 1))))

(constraint (or (= (sign x) (- 1)) (or (= (sign x) 0) (= (sign x) 1))))

(check-synth)
