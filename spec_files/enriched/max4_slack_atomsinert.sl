; max4_slack_atomsinert.sl — generated by scripts/gen_enriched_grammars.jl from spec_files/multi_answer/max4_slack.sl.
; E5 inert placebo for atoms: 24 always-false atoms (d ≥ d + 1 with d = left − right of a real atom) and 4 terms equal to 0 or a variable (each 1 of a real term replaced by 0).

; max4_slack.sl — a MULTI-ANSWER specification: any value in [max, max+1] of 4 integers.
;
; Built to test incomplete tests (src/GeneticSearch/incomplete_tests.jl). At
; every input the spec accepts more than one output, so a counterexample's output
; cannot be demanded of later candidates: CDGP must keep the input only.
; Grammar: the CDGP-paper LIA grammar used by spec_files/paired/cdgp/*.sl.
; Known solution: the maximum (ite chains), or maximum + 1.

(set-logic LIA)

(synth-fun max4_slack ((w Int) (x Int) (y Int) (z Int)) Int
    (
     (Start Int (w
                 x
                 y
                 z
                 0
                 1
                 (+ Start Start)
                 (- Start Start)
                 (ite StartBool Start Start)
                 (+ w 0)
                 (+ x 0)
                 (+ y 0)
                 (+ z 0)))
     (StartBool Bool ((and StartBool StartBool)
                      (or StartBool StartBool)
                      (not StartBool)
                      (<= Start Start)
                      (= Start Start)
                      (>= Start Start)
                      (>= (- w x) (+ (- w x) 1))
                      (>= (- w y) (+ (- w y) 1))
                      (>= (- w z) (+ (- w z) 1))
                      (>= (- x w) (+ (- x w) 1))
                      (>= (- x y) (+ (- x y) 1))
                      (>= (- x z) (+ (- x z) 1))
                      (>= (- y w) (+ (- y w) 1))
                      (>= (- y x) (+ (- y x) 1))
                      (>= (- y z) (+ (- y z) 1))
                      (>= (- z w) (+ (- z w) 1))
                      (>= (- z x) (+ (- z x) 1))
                      (>= (- z y) (+ (- z y) 1))
                      (>= (- w (- x 1)) (+ (- w (- x 1)) 1))
                      (>= (- w (- y 1)) (+ (- w (- y 1)) 1))
                      (>= (- w (- z 1)) (+ (- w (- z 1)) 1))
                      (>= (- x (- w 1)) (+ (- x (- w 1)) 1))
                      (>= (- x (- y 1)) (+ (- x (- y 1)) 1))
                      (>= (- x (- z 1)) (+ (- x (- z 1)) 1))
                      (>= (- y (- w 1)) (+ (- y (- w 1)) 1))
                      (>= (- y (- x 1)) (+ (- y (- x 1)) 1))
                      (>= (- y (- z 1)) (+ (- y (- z 1)) 1))
                      (>= (- z (- w 1)) (+ (- z (- w 1)) 1))
                      (>= (- z (- x 1)) (+ (- z (- x 1)) 1))
                      (>= (- z (- y 1)) (+ (- z (- y 1)) 1))))))

(declare-var w Int)
(declare-var x Int)
(declare-var y Int)
(declare-var z Int)

(constraint (>= (max4_slack w x y z) w))
(constraint (>= (max4_slack w x y z) x))
(constraint (>= (max4_slack w x y z) y))
(constraint (>= (max4_slack w x y z) z))
(constraint (or (<= (max4_slack w x y z) (+ w 1)) (<= (max4_slack w x y z) (+ x 1)) (<= (max4_slack w x y z) (+ y 1)) (<= (max4_slack w x y z) (+ z 1))))

(check-synth)
