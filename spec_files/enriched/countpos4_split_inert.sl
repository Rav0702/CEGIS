; countpos4_split_inert.sl — generated by scripts/gen_enriched_grammars.jl from spec_files/case_split/countpos4_split.sl.
; E5a inert placebo: 16 productions (ite ⊥ Start Start), ⊥ a recipe guard with one atom replaced by the negation of another (unsatisfiable, z3-checked): they never fire.

; countpos4_split.sl — count of positive inputs among 4, as a 16-way CASE SPLIT.
;
; Written like the reference CDGP's CountPositive3.sl (one guarded constraint per sign
; pattern, see spec_files/paired/cdgp/countpos3.sl); the reference's CountPositive4.sl is
; instead a single functional constraint through a define-fun, which is outside the
; in-process solvers' scope. This 16-case form is our construction.
; Grammar: the CDGP-paper LIA grammar. Single-answer (the 16 guards cover every input).

(set-logic LIA)

(synth-fun countpos4 ((x Int) (y Int) (z Int) (w Int)) Int
    (
     (Start Int (x
                 y
                 z
                 w
                 0
                 1
                 (+ Start Start)
                 (- Start Start)
                 (ite StartBool Start Start)
                 (ite (and (and (<= x 0) (>= x (+ 0 1))) (and (<= z 0) (<= w 0))) Start Start)
                 (ite (and (and (>= x 1) (<= x (- 1 1))) (and (<= z 0) (<= w 0))) Start Start)
                 (ite (and (and (<= x 0) (>= y 1)) (and (>= x (+ 0 1)) (<= w 0))) Start Start)
                 (ite (and (and (>= x 1) (>= y 1)) (and (<= x (- 1 1)) (<= w 0))) Start Start)
                 (ite (and (and (<= x 0) (>= x (+ 0 1))) (and (>= z 1) (<= w 0))) Start Start)
                 (ite (and (and (>= x 1) (<= x (- 1 1))) (and (>= z 1) (<= w 0))) Start Start)
                 (ite (and (and (<= x 0) (>= y 1)) (and (>= z 1) (>= x (+ 0 1)))) Start Start)
                 (ite (and (and (>= x 1) (>= y 1)) (and (>= z 1) (<= x (- 1 1)))) Start Start)
                 (ite (and (and (<= x 0) (>= x (+ 0 1))) (and (<= z 0) (>= w 1))) Start Start)
                 (ite (and (and (>= x 1) (<= x (- 1 1))) (and (<= z 0) (>= w 1))) Start Start)
                 (ite (and (and (<= x 0) (>= y 1)) (and (>= x (+ 0 1)) (>= w 1))) Start Start)
                 (ite (and (and (>= x 1) (>= y 1)) (and (<= x (- 1 1)) (>= w 1))) Start Start)
                 (ite (and (and (<= x 0) (>= x (+ 0 1))) (and (>= z 1) (>= w 1))) Start Start)
                 (ite (and (and (>= x 1) (<= x (- 1 1))) (and (>= z 1) (>= w 1))) Start Start)
                 (ite (and (and (<= y (- 1 1)) (>= y 1)) (and (>= z 1) (>= w 1))) Start Start)
                 (ite (and (and (>= x 1) (>= y 1)) (and (<= y (- 1 1)) (>= w 1))) Start Start)))
     (StartBool Bool ((and StartBool StartBool)
                      (or StartBool StartBool)
                      (not StartBool)
                      (<= Start Start)
                      (= Start Start)
                      (>= Start Start)))))

(declare-var x Int)
(declare-var y Int)
(declare-var z Int)
(declare-var w Int)

(constraint (=> (and (<= x 0) (<= y 0) (<= z 0) (<= w 0)) (= (countpos4 x y z w) 0)))
(constraint (=> (and (> x 0) (<= y 0) (<= z 0) (<= w 0)) (= (countpos4 x y z w) 1)))
(constraint (=> (and (<= x 0) (> y 0) (<= z 0) (<= w 0)) (= (countpos4 x y z w) 1)))
(constraint (=> (and (> x 0) (> y 0) (<= z 0) (<= w 0)) (= (countpos4 x y z w) 2)))
(constraint (=> (and (<= x 0) (<= y 0) (> z 0) (<= w 0)) (= (countpos4 x y z w) 1)))
(constraint (=> (and (> x 0) (<= y 0) (> z 0) (<= w 0)) (= (countpos4 x y z w) 2)))
(constraint (=> (and (<= x 0) (> y 0) (> z 0) (<= w 0)) (= (countpos4 x y z w) 2)))
(constraint (=> (and (> x 0) (> y 0) (> z 0) (<= w 0)) (= (countpos4 x y z w) 3)))
(constraint (=> (and (<= x 0) (<= y 0) (<= z 0) (> w 0)) (= (countpos4 x y z w) 1)))
(constraint (=> (and (> x 0) (<= y 0) (<= z 0) (> w 0)) (= (countpos4 x y z w) 2)))
(constraint (=> (and (<= x 0) (> y 0) (<= z 0) (> w 0)) (= (countpos4 x y z w) 2)))
(constraint (=> (and (> x 0) (> y 0) (<= z 0) (> w 0)) (= (countpos4 x y z w) 3)))
(constraint (=> (and (<= x 0) (<= y 0) (> z 0) (> w 0)) (= (countpos4 x y z w) 2)))
(constraint (=> (and (> x 0) (<= y 0) (> z 0) (> w 0)) (= (countpos4 x y z w) 3)))
(constraint (=> (and (<= x 0) (> y 0) (> z 0) (> w 0)) (= (countpos4 x y z w) 3)))
(constraint (=> (and (> x 0) (> y 0) (> z 0) (> w 0)) (= (countpos4 x y z w) 4)))

(check-synth)
