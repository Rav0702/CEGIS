(set-logic LIA)

(synth-fun median3 ((x Int) (y Int) (z Int)) Int
    (
     (Start Int (x
                 y
                 z
                 0
                 1
                 (+ Start Start)
                 (- Start Start)
                 (ite StartBool Start Start)))
     (StartBool Bool ((and StartBool StartBool)
                      (or StartBool StartBool)
                      (not StartBool)
                      (<= Start Start)
                      (= Start Start)
                      (>= Start Start)
                      (>= (- x (+ y 1)) (+ (- x (+ y 1)) 1))
                      (>= (- y (+ z 1)) (+ (- y (+ z 1)) 1))
                      (<= (+ (- y z) 1) (- y z))
                      (>= (- x (+ z 1)) (+ (- x (+ z 1)) 1))
                      (<= (+ (- x z) 1) (- x z))
                      (<= (+ (- x y) 1) (- x y))))))

(declare-var x Int)
(declare-var y Int)
(declare-var z Int)

(constraint (=> (> x y) (=> (> y z) (= (median3 x y z) y) ) ))
(constraint (=> (> x y) (=> (<= y z) (=> (> x z) (= (median3 x y z) z) ) ) ) )
(constraint (=> (> x y) (=> (<= y z) (=> (<= x z ) (= (median3 x y z) x) ) ) ) )
(constraint (=> (<= x y) (=> (> x z) (= (median3 x y z) x) ) ) )
(constraint (=> (<= x y) (=> (<= x z) (=> (> y z) (= (median3 x y z) z) ) ) ) )
(constraint (=> (<= x y) (=> (<= x z) (=> (<= y z ) (= (median3 x y z) y) ) ) ) )

(check-synth)
