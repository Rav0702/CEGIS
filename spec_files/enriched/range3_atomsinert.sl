; E5 inert placebo for atoms: 6 always-false atoms (d ≥ d + 1 with d = left − right of a real atom) and 6 terms equal to 0 or a variable (each 1 of a real term replaced by 0).

; range3.sl — CDGP's specification of this problem.
;
; GENERATED by spec_files/paired/build_pairs.py — do not edit by hand.
;
; Constraints transcribed from
;   ~/.julia/dev/CDGP/resources/benchmarks_phd/cdgp/LIA/other/Range3.sl
; with their parameters renamed a,b,c -> x,y,z.
;
; The synth-fun signature and grammar block are copied verbatim from
;   spec_files/cdgp_paper/range3.sl
; so this file and ours/range3.sl differ ONLY in specification style.

(set-logic LIA)

(synth-fun range3 ((x Int) (y Int) (z Int)) Int
    (
     (Start Int (x
                 y
                 z
                 0
                 1
                 (+ Start Start)
                 (- Start Start)
                 (ite StartBool Start Start)
                 (- z z)
                 (- y y)
                 (+ y 0)
                 (- x x)
                 (+ z 0)
                 (+ x 0)))
     (StartBool Bool ((and StartBool StartBool)
                      (or StartBool StartBool)
                      (not StartBool)
                      (<= Start Start)
                      (= Start Start)
                      (>= Start Start)
                      (<= (+ (- x y) 1) (- x y))
                      (<= (+ (- y z) 1) (- y z))
                      (>= (- y z) (+ (- y z) 1))
                      (<= (+ (- x z) 1) (- x z))
                      (>= (- x z) (+ (- x z) 1))
                      (>= (- x y) (+ (- x y) 1))))))

(declare-var x Int)
(declare-var y Int)
(declare-var z Int)

(constraint (=> (and (<= x y)  (<= y z))  (= (range3 x y z) (- z x))))
(constraint (=> (and (<= x y)  (>= y z)  (<= x z)) (= (range3 x y z) (- y x))))
(constraint (=> (and (<= x y)  (>= y z)  (>= x z)) (= (range3 x y z) (- y z))))
(constraint (=> (and (>= x y)  (<= y z)  (>= x z))  (= (range3 x y z) (- x y))))
(constraint (=> (and (>= x y)  (<= y z)  (<= x z))  (= (range3 x y z) (- z y))))
(constraint (=> (and (>= x y)  (>= y z)) (= (range3 x y z) (- x z))))

(check-synth)
