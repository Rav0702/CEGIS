; hidden3_blocksinert.sl — generated by scripts/gen_enriched_grammars.jl from spec_files/partial_knowledge/hidden3.sl.
; E5 inert placebo for blocks: E5a's 2 unsatisfiable guards as Bool productions and 0 terms equal to 0 or a variable.

; hidden3.sl — partial knowledge with HIDDEN SUB-SPLITS (spec_knowledge/, E6b option (a)). Sibling of tiered3.sl.
;
; Four regions of (x, y, z):
;   A  x < 0                       f = 0                                               written -> recipe
;   B  x >= 0, y < 0               f = x                                               written -> recipe
;   C  x >= 0, y >= 0, z >= 0      f - z >= x,  f - z >= y,  f - z in {x, y}           answer max(x, y) + z
;   D  x >= 0, y >= 0, z < 0       f + z <= x + z,  f + z <= y + z + 1,  f + z in {x + z, y + z + 1}
;                                                                                      answer min(x, y + 1)
; In C and D, f only appears inside arithmetic, so the compiler gets each region's guard but no answer; and each
; answer needs its own case split (max / min) that the spec never states as a premise: a linear term solver
; cannot build it. Single-invocation and single-answer.
; Known solution: (ite (< x 0) 0 (ite (< y 0) x (ite (>= z 0) (+ (ite (>= x y) x y) z) (ite (<= x (+ y 1)) x (+ y 1)))))
; Grammar: the SyGuS-COMP LIA grammar used by the other case-split specs.

(set-logic LIA)

(synth-fun hidden3 ((x Int) (y Int) (z Int)) Int
    (
     (Start Int (x
                 y
                 z
                 0
                 1
                 (+ Start Start)
                 (- Start Start)
                 (ite StartBool Start Start)))
     (StartBool Bool ((and StartBool StartBool)
                      (or StartBool StartBool)
                      (not StartBool)
                      (<= Start Start)
                      (= Start Start)
                      (>= Start Start)
                      (<= (+ (- x (- 0 1)) 1) (- x (- 0 1)))
                      (and (>= x 0) (<= x (- 0 1)))))))

(declare-var x Int)
(declare-var y Int)
(declare-var z Int)

(constraint (=> (< x 0) (= (hidden3 x y z) 0)))
(constraint (=> (and (>= x 0) (< y 0)) (= (hidden3 x y z) x)))
(constraint (=> (and (>= x 0) (and (>= y 0) (>= z 0)))
                (and (>= (- (hidden3 x y z) z) x)
                     (and (>= (- (hidden3 x y z) z) y)
                          (or (= (- (hidden3 x y z) z) x) (= (- (hidden3 x y z) z) y))))))
(constraint (=> (and (>= x 0) (and (>= y 0) (< z 0)))
                (and (<= (+ (hidden3 x y z) z) (+ x z))
                     (and (<= (+ (hidden3 x y z) z) (+ y (+ z 1)))
                          (or (= (+ (hidden3 x y z) z) (+ x z)) (= (+ (hidden3 x y z) z) (+ y (+ z 1))))))))

(check-synth)
