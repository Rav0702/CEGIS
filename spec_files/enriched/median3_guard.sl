(set-logic LIA)

(synth-fun median3 ((x Int) (y Int) (z Int)) Int
    (
     (Start Int (x
                 y
                 z
                 0
                 1
                 (+ Start Start)
                 (- Start Start)
                 (ite StartBool Start Start)
                 (ite (and (>= x (+ y 1)) (>= y (+ z 1))) Start Start)
                 (ite (and (>= x (+ y 1)) (and (<= y z) (>= x (+ z 1)))) Start Start)
                 (ite (and (>= x (+ y 1)) (and (<= y z) (<= x z))) Start Start)
                 (ite (and (<= x y) (>= x (+ z 1))) Start Start)
                 (ite (and (<= x y) (and (<= x z) (>= y (+ z 1)))) Start Start)
                 (ite (and (<= x y) (and (<= x z) (<= y z))) Start Start)))
     (StartBool Bool ((and StartBool StartBool)
                      (or StartBool StartBool)
                      (not StartBool)
                      (<= Start Start)
                      (= Start Start)
                      (>= Start Start)))))

(declare-var x Int)
(declare-var y Int)
(declare-var z Int)

(constraint (=> (> x y) (=> (> y z) (= (median3 x y z) y) ) ))
(constraint (=> (> x y) (=> (<= y z) (=> (> x z) (= (median3 x y z) z) ) ) ) )
(constraint (=> (> x y) (=> (<= y z) (=> (<= x z ) (= (median3 x y z) x) ) ) ) )
(constraint (=> (<= x y) (=> (> x z) (= (median3 x y z) x) ) ) )
(constraint (=> (<= x y) (=> (<= x z) (=> (> y z) (= (median3 x y z) z) ) ) ) )
(constraint (=> (<= x y) (=> (<= x z) (=> (<= y z ) (= (median3 x y z) y) ) ) ) )

