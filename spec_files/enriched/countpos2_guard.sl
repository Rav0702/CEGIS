(set-logic LIA)

(synth-fun countpos2 ((x Int) (y Int)) Int
    (
     (Start Int (x
                 y
                 0
                 1
                 (+ Start Start)
                 (- Start Start)
                 (ite StartBool Start Start)
                 (ite (and (<= x 0) (<= y 0)) Start Start)
                 (ite (and (>= x 1) (<= y 0)) Start Start)
                 (ite (and (<= x 0) (>= y 1)) Start Start)
                 (ite (and (>= x 1) (>= y 1)) Start Start)))
     (StartBool Bool ((and StartBool StartBool)
                      (or StartBool StartBool)
                      (not StartBool)
                      (<= Start Start)
                      (= Start Start)
                      (>= Start Start)))))

(declare-var x Int)
(declare-var y Int)

(constraint (=> (and (<= x 0) (<= y 0)) (= (countpos2 x y) 0)))
(constraint (=> (and (> x 0)  (<= y 0)) (= (countpos2 x y) 1)))
(constraint (=> (and (<= x 0) (> y 0))  (= (countpos2 x y) 1)))
(constraint (=> (and (> x 0)  (> y 0))  (= (countpos2 x y) 2)))

(check-synth)
