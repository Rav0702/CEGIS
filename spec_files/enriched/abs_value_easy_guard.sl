; abs_value_easy_guard.sl — generated by scripts/gen_enriched_grammars.jl from spec_files/confirmatory/abs_value_easy.sl.
; E5a guard-only grammar: one production (ite G Start Start) per recipe guard (3): where the regions are, not their answers.

; abs_value_easy.sl — confirmatory-phase spec (spec_knowledge/FULL_SCALE_PLAN.md).
;
; GENERATED by scripts/make_confirmatory_specs.py — do not edit by hand.
; Constraints verbatim from
;   CEGIS\benchmarks\abs_value\easy.sl
; which has no grammar block. The CDGP-paper LIA grammar is added, the parameters are named like the
; declared variables, and unused declare-funs are dropped.

(set-logic LIA)

(synth-fun abs_val ((x Int)) Int
    (
     (Start Int (x
                 0
                 1
                 (+ Start Start)
                 (- Start Start)
                 (ite StartBool Start Start)
                 (ite (>= x 0) Start Start)
                 (ite (<= x (- 0 1)) Start Start)
                 (ite (and (or (<= (+ x 1) 0) (= 0 x)) (or (>= x (+ (- 0 1) 1)) (= 0 (- 0 x)))) Start Start)))
     (StartBool Bool ((and StartBool StartBool)
                      (or StartBool StartBool)
                      (not StartBool)
                      (<= Start Start)
                      (= Start Start)
                      (>= Start Start)))))
(declare-var x Int)

(constraint (>= (abs_val x) 0))

(constraint (=> (>= x 0) (= (abs_val x) x)))

(constraint (=> (< x 0) (= (abs_val x) (- x))))

(check-synth)
