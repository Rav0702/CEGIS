; above4_guarddecoy.sl — generated by scripts/gen_enriched_grammars.jl from spec_files/multi_answer/above4.sl.
; E5a scrambled-guard placebo: 4 productions (ite G̃ Start Start), G̃ a scrambled recipe guard that fires where the spec has tests and matches no real region (Jaccard <= 0.5, inside none, not a union; seed fixed).

; above4.sl — a MULTI-ANSWER specification: any value strictly greater than all of 4 integers.
;
; Built to test incomplete tests (src/GeneticSearch/incomplete_tests.jl). At
; every input the spec accepts more than one output, so a counterexample's output
; cannot be demanded of later candidates: CDGP must keep the input only.
; Grammar: the CDGP-paper LIA grammar used by spec_files/paired/cdgp/*.sl.
; Known solution: maximum + 1.

(set-logic LIA)

(synth-fun above4 ((w Int) (x Int) (y Int) (z Int)) Int
    (
     (Start Int (w
                 x
                 y
                 z
                 0
                 1
                 (+ Start Start)
                 (- Start Start)
                 (ite StartBool Start Start)
                 (ite (and (>= w x) (and (>= w y) (>= x y))) Start Start)
                 (ite (and (>= y w) (and (>= w z) (>= w y))) Start Start)
                 (ite (and (>= z w) (and (>= y w) (>= w z))) Start Start)
                 (ite (and (>= x y) (and (>= x y) (>= z x))) Start Start)))
     (StartBool Bool ((and StartBool StartBool)
                      (or StartBool StartBool)
                      (not StartBool)
                      (<= Start Start)
                      (= Start Start)
                      (>= Start Start)))))

(declare-var w Int)
(declare-var x Int)
(declare-var y Int)
(declare-var z Int)

(constraint (> (above4 w x y z) w))
(constraint (> (above4 w x y z) x))
(constraint (> (above4 w x y z) y))
(constraint (> (above4 w x y z) z))

(check-synth)
