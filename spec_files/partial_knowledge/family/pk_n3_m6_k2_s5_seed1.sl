; pk_n3_m6_k2_s5_seed1.sl — generated by scripts/gen_partial_family.py (spec_knowledge/, E6b).
; 6 regions over (x, y, z); 2 write their answer (recipes), 4 give it only as a relation (guard-only); answers ~5 nodes.
; Known solution: (ite (< z 0) (+ (+ x x) y) (ite (>= y 0) (- (+ y z) x) (ite (> y x) (+ (+ x z) 1) (ite (< x 0) (+ (+ x y) z) (ite (<= x z) (- (+ z 1) y) (+ (+ x x) y))))))

(set-logic LIA)

(synth-fun pk ( (x Int) (y Int) (z Int) ) Int
    ((Start Int (x y z 0 1
                 (+ Start Start)
                 (- Start Start)
                 (ite StartBool Start Start)))
     (StartBool Bool ((and StartBool StartBool)
                      (or  StartBool StartBool)
                      (not StartBool)
                      (<=  Start Start)
                      (=   Start Start)
                      (>=  Start Start)))))

(declare-var x Int)
(declare-var y Int)
(declare-var z Int)

(constraint (=> (< z 0) (= (- (pk x y z) (+ y x)) x)))
(constraint (=> (and (not (< z 0)) (>= y 0)) (= (- (pk x y z) (- y x)) z)))
(constraint (=> (and (not (< z 0)) (not (>= y 0)) (> y x)) (= (- (pk x y z) (+ 1 x)) z)))
(constraint (=> (and (not (< z 0)) (not (>= y 0)) (not (> y x)) (< x 0)) (= (pk x y z) (+ (+ x y) z))))
(constraint (=> (and (not (< z 0)) (not (>= y 0)) (not (> y x)) (not (< x 0)) (<= x z)) (= (pk x y z) (- (+ z 1) y))))
(constraint (=> (and (not (< z 0)) (not (>= y 0)) (not (> y x)) (not (< x 0)) (not (<= x z))) (= (- (pk x y z) (+ y x)) x)))

(check-synth)
